# Database Configuration (used by Docker Compose and Node.js application)
DB_NAME=supermarket
DB_USER=supermarket_user
DB_PASSWORD=change_this_password

# Logging Configuration
LOG_LEVEL=INFO

# CORS: comma separated list of allowed web origins (e.g. the Baskit web app).
# Leave empty to allow every origin (development).
CORS_ORIGINS=

# Full product catalog scrape (regular prices), run in each supermarket's
# weekly run right before its offers. false leaves that step out.
CATALOG_ENABLED=true

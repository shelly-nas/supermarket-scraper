# Database Configuration (used by Docker Compose and Node.js application)
DB_NAME=supermarket
DB_USER=supermarket_user
DB_PASSWORD=change_this_password

# Logging Configuration
LOG_LEVEL=INFO

# CORS: comma separated list of allowed web origins (e.g. the Baskit web app).
# Leave empty to allow every origin (development).
CORS_ORIGINS=

# Full product catalog scrape (regular prices): the assortment step of each
# supermarket's run, which also yields the offers where the source carries
# them. false leaves that step out (offers only).
CATALOG_ENABLED=true
